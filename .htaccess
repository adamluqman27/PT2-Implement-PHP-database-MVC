Options -MultiViews
RewriteEngine On

# Ini untuk pastikan dia tahu folder pt2 kat server mana
RewriteBase /users/a203267/pt2/

# Kalau fail atau folder tu wujud, jangan redirect
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

# Redirect semua URL lain ke index.php
RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]